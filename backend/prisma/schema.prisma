// YarnTrace Prisma Schema
// PostgreSQL Database Schema for Yarn Inventory & Production Traceability System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum YarnType {
  GREY
  DYED
  COMBED
  CARDED
  OPEN_END
  COMPACT
  BLENDED
  SYNTHETIC
}

enum LotStatus {
  RECEIVED
  QUALITY_PENDING
  APPROVED
  IN_PRODUCTION
  EXHAUSTED
  QUARANTINED
  RETIRED
}

enum TransactionType {
  RECEIVED
  OPENING
  ISSUED
  RETURNED
  RETIRED
  ADJUSTMENT
  TRANSFER
}

enum TransactionStatus {
  DRAFT
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum YarnAllocationStatus {
  ALLOCATED
  PARTIALLY_ISSUED
  FULLY_ISSUED
  CANCELLED
}

enum DyeingOrderStatus {
  DRAFT
  DISPATCHED
  IN_PROCESSING
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum DyeingMovementType {
  OUTWARD_DISPATCH
  INWARD_RECEIPT
  RETURN
}

enum POStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DELIVERED
  FULFILLED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  DYEING_MILL
  JOB_WORKER
  INTERNAL
}

// =============================================================================
// 1. IDENTITY & ACCESS CONTROL
// =============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  status       UserStatus @default(ACTIVE)
  refreshTokenHash String?

  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])

  userPermissions UserPermission[]
  auditLogs       AuditLog[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users           User[]
  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  module      String
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  isGranted    Boolean    @default(true) // Explicit grant or override revoke

  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

// =============================================================================
// 2. YARN & LOT MASTER
// =============================================================================

model Yarn {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  type          YarnType @default(GREY)
  yarnCount     String   // e.g. "40s Ne", "30/1", "20/2"
  composition   String   // e.g. "100% Combed Cotton", "60/40 Poly Cotton"
  color         String?  // e.g. "Raw Natural", "Optic White"
  description   String?
  isActive      Boolean  @default(true)

  lots          Lot[]
  poRequirements PORequirement[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([type])
  @@index([yarnCount])
}

model Lot {
  id             String    @id @default(uuid())
  lotNumber      String    @unique
  yarnId         String
  yarn           Yarn      @relation(fields: [yarnId], references: [id])
  supplierId     String?
  supplier       Party?    @relation("SupplierLots", fields: [supplierId], references: [id])
  
  initialBags    Int       @default(0)
  initialCones   Int       @default(0)
  initialWeightKg Decimal  @db.Decimal(12, 4) // Initial received/opening net KG
  currentWeightKg Decimal  @db.Decimal(12, 4) // Aggregated current KG across locations
  
  status         LotStatus @default(RECEIVED)
  receivedDate   DateTime  @default(now())
  millLotNumber  String?   // Supplier's original lot number
  shadeCode      String?
  remarks        String?

  stockBalances       StockBalance[]
  transactionItems    TransactionItem[]
  yarnAllocations     YarnAllocation[]
  consumptionRecords  ConsumptionRecord[]
  dyeingMovements     DyeingMovement[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lotNumber])
  @@index([yarnId])
  @@index([status])
}

// =============================================================================
// 3. INVENTORY & STOCK BALANCES
// =============================================================================

model StockLocation {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String   // "WAREHOUSE", "SILO", "FLOOR_STAGE", "BAY"
  description String?
  isActive    Boolean  @default(true)

  stockBalances       StockBalance[]
  sourceTransactions  TransactionItem[] @relation("SourceLocation")
  targetTransactions  TransactionItem[] @relation("TargetLocation")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model StockBalance {
  id           String        @id @default(uuid())
  lotId        String
  lot          Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  locationId   String
  location     StockLocation @relation(fields: [locationId], references: [id])
  
  quantityKg   Decimal       @db.Decimal(12, 4)
  bagsCount    Int           @default(0)
  conesCount   Int           @default(0)
  
  lastUpdated  DateTime      @default(now()) @updatedAt

  @@unique([lotId, locationId])
  @@index([lotId])
  @@index([locationId])
}

model Transaction {
  id              String            @id @default(uuid())
  transactionNumber String          @unique
  type            TransactionType
  status          TransactionStatus @default(COMPLETED)
  transactionDate DateTime          @default(now())
  referenceNumber String?           // Invoice / Gate pass / Delivery Challan no.
  notes           String?
  createdById     String?

  items           TransactionItem[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([transactionNumber])
  @@index([type])
  @@index([transactionDate])
}

model TransactionItem {
  id                String         @id @default(uuid())
  transactionId     String
  transaction       Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lotId             String
  lot               Lot            @relation(fields: [lotId], references: [id])
  
  sourceLocationId  String?
  sourceLocation    StockLocation? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  targetLocationId  String?
  targetLocation    StockLocation? @relation("TargetLocation", fields: [targetLocationId], references: [id])

  quantityKg        Decimal        @db.Decimal(12, 4)
  grossWeightKg     Decimal?       @db.Decimal(12, 4)
  tareWeightKg      Decimal?       @db.Decimal(12, 4)
  bagsCount         Int            @default(0)
  conesCount        Int            @default(0)
  remarks           String?

  createdAt         DateTime       @default(now())

  @@index([transactionId])
  @@index([lotId])
}

// =============================================================================
// 4. PRODUCTION & CONSUMPTION
// =============================================================================

model ProductionTeam {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  department  String   // "SPINNING", "WARPING", "WEAVING", "KNITTING"
  teamLead    String?
  isActive    Boolean  @default(true)

  allocations        YarnAllocation[]
  consumptionRecords ConsumptionRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model ProductionOrder {
  id            String                @id @default(uuid())
  orderNumber   String                @unique
  status        ProductionOrderStatus @default(PLANNED)
  targetQuantity Decimal              @db.Decimal(12, 4)
  unit          String                @default("KG")
  startDate     DateTime?
  targetDate    DateTime?
  completedDate DateTime?
  remarks       String?

  allocations        YarnAllocation[]
  consumptionRecords ConsumptionRecord[]
  products           Product[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([orderNumber])
  @@index([status])
}

model YarnAllocation {
  id                String               @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder      @relation(fields: [productionOrderId], references: [id])
  productionTeamId  String
  productionTeam    ProductionTeam       @relation(fields: [productionTeamId], references: [id])
  lotId             String
  lot               Lot                  @relation(fields: [lotId], references: [id])

  allocatedKg       Decimal              @db.Decimal(12, 4)
  issuedKg          Decimal              @default(0) @db.Decimal(12, 4)
  status            YarnAllocationStatus @default(ALLOCATED)
  allocatedDate     DateTime             @default(now())
  remarks           String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([productionOrderId])
  @@index([productionTeamId])
  @@index([lotId])
}

model ConsumptionRecord {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productionTeamId  String
  productionTeam    ProductionTeam  @relation(fields: [productionTeamId], references: [id])
  lotId             String
  lot               Lot             @relation(fields: [lotId], references: [id])

  consumedKg        Decimal         @db.Decimal(12, 4)
  wasteKg           Decimal         @default(0) @db.Decimal(12, 4)
  netProducedKg     Decimal?        @db.Decimal(12, 4)
  consumptionDate   DateTime        @default(now())
  recordedById      String?
  remarks           String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productionOrderId])
  @@index([productionTeamId])
  @@index([lotId])
  @@index([consumptionDate])
}

// =============================================================================
// 5. OUTPUT & DELIVERIES
// =============================================================================

model Product {
  id                String           @id @default(uuid())
  productCode       String           @unique
  name              String
  description       String?
  category          String?          // "FABRIC_ROLL", "FINISHED_YARN", "GARMENT"
  
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  totalQuantityKg   Decimal          @db.Decimal(12, 4)
  availableKg       Decimal          @db.Decimal(12, 4)
  unit              String           @default("KG")
  isActive          Boolean          @default(true)

  deliveries        Delivery[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productCode])
}

model Delivery {
  id              String         @id @default(uuid())
  deliveryNumber  String         @unique
  partyId         String
  party           Party          @relation(fields: [partyId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])

  dispatchedKg    Decimal        @db.Decimal(12, 4)
  status          DeliveryStatus @default(DRAFT)
  dispatchDate    DateTime       @default(now())
  vehicleNumber   String?
  driverContact   String?
  lrNumber        String?        // Lorry receipt number
  remarks         String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([deliveryNumber])
  @@index([partyId])
  @@index([productId])
}

// =============================================================================
// 6. COMMERCIAL & DYEING
// =============================================================================

model Party {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  type          PartyType @default(CUSTOMER)
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  isActive      Boolean   @default(true)

  suppliedLots   Lot[]           @relation("SupplierLots")
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  dyeingOrders   DyeingOrder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
  @@index([type])
}

model PurchaseOrder {
  id          String          @id @default(uuid())
  poNumber    String          @unique
  partyId     String
  party       Party           @relation(fields: [partyId], references: [id])
  status      POStatus        @default(CONFIRMED)
  orderDate   DateTime        @default(now())
  deliveryDue DateTime?
  totalAmount Decimal?        @db.Decimal(14, 2)
  remarks     String?

  requirements PORequirement[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([poNumber])
  @@index([partyId])
}

model PORequirement {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  yarnId          String
  yarn            Yarn          @relation(fields: [yarnId], references: [id])

  requiredKg      Decimal       @db.Decimal(12, 4)
  issuedKg        Decimal       @default(0) @db.Decimal(12, 4)
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([yarnId])
}

model DyeingOrder {
  id          String            @id @default(uuid())
  orderNumber String            @unique
  dyeingMillId String
  dyeingMill  Party             @relation(fields: [dyeingMillId], references: [id])
  status      DyeingOrderStatus @default(DRAFT)
  targetShade String
  targetKg    Decimal           @db.Decimal(12, 4)
  orderDate   DateTime          @default(now())
  expectedDate DateTime?
  remarks     String?

  movements   DyeingMovement[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([orderNumber])
  @@index([dyeingMillId])
}

model DyeingMovement {
  id            String             @id @default(uuid())
  dyeingOrderId String
  dyeingOrder   DyeingOrder        @relation(fields: [dyeingOrderId], references: [id])
  lotId         String
  lot           Lot                @relation(fields: [lotId], references: [id])
  type          DyeingMovementType
  
  quantityKg    Decimal            @db.Decimal(12, 4)
  movementDate  DateTime           @default(now())
  challanNumber String?
  notes         String?

  createdAt     DateTime           @default(now())

  @@index([dyeingOrderId])
  @@index([lotId])
}

// =============================================================================
// 7. GOVERNANCE & AUDITING
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "CREATE", "UPDATE", "DELETE", "ISSUE_YARN", "LOGIN"
  module     String   // e.g. "INVENTORY", "AUTH", "PRODUCTION", "LOTS"
  entityType String   // e.g. "Lot", "Transaction", "User"
  entityId   String?  // Target record UUID
  oldValue   Json?    // Snapshot before mutation
  newValue   Json?    // Snapshot after mutation
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([timestamp])
}
